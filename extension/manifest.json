{
  "manifest_version": 3,
  "name": "ClutterShield Pakistan",
  "version": "0.1.0",
  "description": "Check a user-entered link against a locally cached, signed threat feed.",
  "minimum_chrome_version": "113",
  "permissions": ["storage", "alarms"],
  "host_permissions": [],
  "optional_permissions": ["webNavigation", "tabs"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Check a suspicious link",
    "default_popup": "popup.html"
  }
}
